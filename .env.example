# Password for the /admin replies dashboard. Without it the dashboard stays closed.
ADMIN_PASSWORD=change-me

# Signing keys. Generate with: openssl rand -hex 32
# Without these, sessions and RSVP tokens are invalidated on every restart.
ADMIN_SESSION_SECRET=
RSVP_TOKEN_SECRET=

# Anthropic API key for the guest concierge (the "Ask us anything" chat).
# Get one at https://console.anthropic.com. Without it the concierge button
# hides itself and the rest of the site is unaffected.
ANTHROPIC_API_KEY=
