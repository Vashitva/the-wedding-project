# Password for the /admin replies dashboard. Without it the dashboard stays closed.
ADMIN_PASSWORD=change-me

# Signing keys. Generate with: openssl rand -hex 32
# Without these, sessions and RSVP tokens are invalidated on every restart.
ADMIN_SESSION_SECRET=
RSVP_TOKEN_SECRET=

# The guest concierge (the "Ask us anything" chat). Set at least one key, or
# the concierge button hides itself and the rest of the site is unaffected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which of the two answers. Omit to use `concierge.defaultProvider` from
# config/wedding.ts. A choice here is only honoured if that provider's key is
# also set — otherwise the concierge stays up on the key that works, and the
# dashboard says what it ignored. The dashboard can override this at runtime.
# CONCIERGE_PROVIDER=anthropic
